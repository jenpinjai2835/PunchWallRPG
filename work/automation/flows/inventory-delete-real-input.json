{
  "name": "inventory-delete-real-input",
  "description": "Verify the visible Inventory Delete button keeps a live callback, arms confirmation, and deletes only the selected authoritative pet after a second real click.",
  "studioName": "^PunchWallRPGPlayable_v1_final[.]rbxlx$",
  "pollAttempts": 15,
  "pollMs": 3000,
  "steps": [
    {
      "type": "call",
      "tool": "start_stop_play",
      "args": { "is_start": true },
      "timeoutMs": 60000,
      "label": "start play and wait for both runtime DataModels"
    },
    {
      "type": "wait",
      "ms": 5500,
      "label": "wait for gameplay bootstrap"
    },
    {
      "type": "call",
      "tool": "execute_luau",
      "args": {
        "datamodel_type": "Server",
        "code": "local c=game.ServerStorage.PunchWallAutomation c:Invoke('Reset') c:Invoke('SetStats',{PetInventoryJSON='[\"Crystal Fox\"]',EquippedPetsJSON='[]',DiscoveredPetsJSON='[\"Crystal Fox\"]',LockedPetsJSON='[]'}) return true"
      },
      "label": "seed one unlocked unequipped pet"
    },
    {
      "type": "call",
      "tool": "execute_luau",
      "args": {
        "datamodel_type": "Client",
        "code": "local H=game:GetService('HttpService') local g=game.Players.LocalPlayer.PlayerGui.PunchWallHUD local a=g.PunchWallClientAutomation a:Invoke('OpenInventory') a:Invoke('SelectInventoryCategory','Pets') a:Invoke('SetInventorySearch','') a:Invoke('SetInventoryRarity','All') a:Invoke('SelectInventoryItem','pet:slot:1') task.wait(.35) local s=a:Invoke('InventorySnapshot') local d=s.selected or {} return H:JSONEncode({visible=s.visible,key=d.key,locked=d.locked,actions=d.actions})"
      },
      "expectRegex": [
        "\"visible\"\\s*:\\s*true",
        "\"key\"\\s*:\\s*\"pet:slot:1\"",
        "\"locked\"\\s*:\\s*false",
        "\"Delete\""
      ],
      "label": "select the deletable pet and settle action controls"
    },
    {
      "type": "call",
      "tool": "user_mouse_input",
      "args": {
        "datamodel_type": "Client",
        "actions": [
          {
            "action": "mouseButtonClick",
            "mouse_button": "left",
            "instance_path_segments": [
              "LocalPlayer",
              "PlayerGui",
              "PunchWallHUD",
              "GameMenu",
              "FunctionalInventory",
              "InventoryWindow",
              "InventoryBody",
              "InventoryDetail",
              "DetailActions",
              "Actiondelete"
            ]
          }
        ]
      },
      "label": "real click arms Delete confirmation"
    },
    {
      "type": "wait",
      "ms": 150,
      "label": "wait for confirmation presentation"
    },
    {
      "type": "call",
      "tool": "execute_luau",
      "args": {
        "datamodel_type": "Client",
        "code": "local H=game:GetService('HttpService') local g=game.Players.LocalPlayer.PlayerGui.PunchWallHUD local r=g.GameMenu.FunctionalInventory local b=r.InventoryWindow.InventoryBody.InventoryDetail.DetailActions.Actiondelete return H:JSONEncode({scheduled=r:GetAttribute('InventoryDeleteConfirmationScheduled'),key=r:GetAttribute('InventoryDeleteConfirmationKey'),text=b.Text,active=b.Active,visible=b.Visible,callbacks=r:GetAttribute('InventoryActionCallbackCount')})"
      },
      "expectRegex": [
        "\"scheduled\"\\s*:\\s*true",
        "\"key\"\\s*:\\s*\"pet:slot:1\"",
        "\"text\"\\s*:\\s*\"CONFIRM DELETE\"",
        "\"active\"\\s*:\\s*true",
        "\"visible\"\\s*:\\s*true"
      ],
      "label": "first click reached the live Inventory callback"
    },
    {
      "type": "call",
      "tool": "user_mouse_input",
      "args": {
        "datamodel_type": "Client",
        "actions": [
          {
            "action": "mouseButtonClick",
            "mouse_button": "left",
            "instance_path_segments": [
              "LocalPlayer",
              "PlayerGui",
              "PunchWallHUD",
              "GameMenu",
              "FunctionalInventory",
              "InventoryWindow",
              "InventoryBody",
              "InventoryDetail",
              "DetailActions",
              "Actiondelete"
            ]
          }
        ]
      },
      "label": "real confirmation click dispatches Delete"
    },
    {
      "type": "wait",
      "ms": 500,
      "label": "wait for authoritative inventory sync"
    },
    {
      "type": "call",
      "tool": "execute_luau",
      "args": {
        "datamodel_type": "Server",
        "code": "local H=game:GetService('HttpService') local p=game.Players:GetPlayers()[1] return H:JSONEncode({inventory=p.RPGStats.PetInventoryJSON.Value,equipped=p.RPGStats.EquippedPetsJSON.Value,locked=p.RPGStats.LockedPetsJSON.Value})"
      },
      "expectRegex": [
        "\"inventory\"\\s*:\\s*\"\\[\\]\"",
        "\"equipped\"\\s*:\\s*\"\\[\\]\"",
        "\"locked\"\\s*:\\s*\"\\[\\]\""
      ],
      "label": "server deleted exactly the selected pet"
    },
    {
      "type": "call",
      "tool": "get_console_output",
      "saveAs": "console",
      "label": "capture Delete regression console"
    },
    {
      "type": "assertNoConsoleErrors",
      "source": "console",
      "label": "Delete regression console clean"
    },
    {
      "type": "call",
      "tool": "start_stop_play",
      "args": { "is_start": false },
      "timeoutMs": 60000,
      "label": "stop play and wait for Edit"
    }
  ],
  "cleanup": [
    {
      "type": "call",
      "tool": "start_stop_play",
      "args": { "is_start": false },
      "timeoutMs": 60000,
      "allowError": true,
      "label": "cleanup Delete regression"
    }
  ]
}
