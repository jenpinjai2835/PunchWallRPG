{
  "name": "contextual-actions-settings-authority",
  "description": "Verify player-facing Train, StopTraining, contextual Use, and Settings remotes reach authoritative validation and normalize unsafe payloads.",
  "studioName": "^PunchWallRPGPlayable_v1_final[.]rbxlx$",
  "pollAttempts": 15,
  "pollMs": 3000,
  "steps": [
    {
      "type": "call",
      "tool": "start_stop_play",
      "args": { "is_start": true },
      "timeoutMs": 60000,
      "label": "start contextual action session"
    },
    {
      "type": "wait",
      "ms": 5500,
      "label": "wait for profile-ready runtime"
    },
    {
      "type": "call",
      "tool": "execute_luau",
      "args": {
        "datamodel_type": "Server",
        "code": "local c=game.ServerStorage.PunchWallAutomation c:Invoke('Reset') c:Invoke('Teleport','Spawn') c:Invoke('ClearCooldowns') return true"
      },
      "label": "place player away from contextual Use targets"
    },
    {
      "type": "call",
      "tool": "execute_luau",
      "args": {
        "datamodel_type": "Client",
        "code": "local g=game.Players.LocalPlayer.PlayerGui.PunchWallHUD g:SetAttribute('LastFeedbackType','') g:SetAttribute('LastFeedbackTarget','') game.ReplicatedStorage.PunchWallEvents.ActionRequest:FireServer({action='Use'}) return true"
      },
      "label": "send real contextual Use request while out of range"
    },
    {
      "type": "wait",
      "ms": 450,
      "label": "settle out-of-range Use feedback"
    },
    {
      "type": "call",
      "tool": "execute_luau",
      "args": {
        "datamodel_type": "Client",
        "code": "local H=game:GetService('HttpService') local g=game.Players.LocalPlayer.PlayerGui.PunchWallHUD return H:JSONEncode({kind=g:GetAttribute('LastFeedbackType'),target=g:GetAttribute('LastFeedbackTarget')})"
      },
      "expectRegex": [
        "\"kind\"\\s*:\\s*\"Fail\"",
        "\"target\"\\s*:\\s*\"Use\""
      ],
      "label": "server rejects out-of-range contextual Use visibly"
    },
    {
      "type": "call",
      "tool": "execute_luau",
      "args": {
        "datamodel_type": "Server",
        "code": "local c=game.ServerStorage.PunchWallAutomation c:Invoke('Teleport','Training') c:Invoke('ClearCooldowns') return true"
      },
      "label": "place player beside current training station"
    },
    {
      "type": "call",
      "tool": "execute_luau",
      "args": {
        "datamodel_type": "Client",
        "code": "game.ReplicatedStorage.PunchWallEvents.ActionRequest:FireServer({action='Train'}) return true"
      },
      "label": "send real Train request"
    },
    {
      "type": "wait",
      "ms": 650,
      "label": "settle training lock and gain state"
    },
    {
      "type": "call",
      "tool": "execute_luau",
      "args": {
        "datamodel_type": "Server",
        "code": "local H=game:GetService('HttpService') local p=game.Players:GetPlayers()[1] local s=p.RPGStats local leaderstats=p.leaderstats return H:JSONEncode({active=s.TrainingActive.Value,locked=p:GetAttribute('TrainingMovementLocked')==true,auto=p:GetAttribute('AutoTrainingActive')==true,power=leaderstats.Power.Value})"
      },
      "expectRegex": [
        "\"active\"\\s*:\\s*1",
        "\"locked\"\\s*:\\s*true",
        "\"auto\"\\s*:\\s*true",
        "\"power\"\\s*:\\s*[1-9][0-9]*"
      ],
      "label": "training becomes authoritative and movement-locked"
    },
    {
      "type": "call",
      "tool": "execute_luau",
      "args": {
        "datamodel_type": "Client",
        "code": "game.ReplicatedStorage.PunchWallEvents.ActionRequest:FireServer({action='StopTraining'}) return true"
      },
      "label": "send real StopTraining request"
    },
    {
      "type": "wait",
      "ms": 400,
      "label": "settle training release"
    },
    {
      "type": "call",
      "tool": "execute_luau",
      "args": {
        "datamodel_type": "Server",
        "code": "local H=game:GetService('HttpService') local p=game.Players:GetPlayers()[1] return H:JSONEncode({active=p.RPGStats.TrainingActive.Value,locked=p:GetAttribute('TrainingMovementLocked')==true,auto=p:GetAttribute('AutoTrainingActive')==true})"
      },
      "expectRegex": [
        "\"active\"\\s*:\\s*0",
        "\"locked\"\\s*:\\s*false",
        "\"auto\"\\s*:\\s*false"
      ],
      "label": "StopTraining releases authoritative movement state"
    },
    {
      "type": "call",
      "tool": "execute_luau",
      "args": {
        "datamodel_type": "Server",
        "code": "local c=game.ServerStorage.PunchWallAutomation c:Invoke('Teleport','PetLab') c:Invoke('ClearCooldowns') return true"
      },
      "label": "place player beside Pet Lab interaction"
    },
    {
      "type": "call",
      "tool": "execute_luau",
      "args": {
        "datamodel_type": "Client",
        "code": "game.ReplicatedStorage.PunchWallEvents.ActionRequest:FireServer({action='Use'}) return true"
      },
      "label": "send real in-range contextual Use request"
    },
    {
      "type": "wait",
      "ms": 650,
      "label": "settle server-opened contextual menu"
    },
    {
      "type": "call",
      "tool": "execute_luau",
      "args": {
        "datamodel_type": "Client",
        "code": "local H=game:GetService('HttpService') local g=game.Players.LocalPlayer.PlayerGui.PunchWallHUD local s=g.PunchWallClientAutomation:Invoke('Snapshot') return H:JSONEncode({menu=s.menuVisible,tab=s.activeTab})"
      },
      "expectRegex": [
        "\"menu\"\\s*:\\s*true",
        "\"tab\"\\s*:\\s*\"Pets\""
      ],
      "label": "in-range Use opens the correct player menu"
    },
    {
      "type": "call",
      "tool": "execute_luau",
      "args": {
        "datamodel_type": "Client",
        "code": "local r=game.ReplicatedStorage.PunchWallEvents.ActionRequest r:FireServer({action='UpdateSettings',value={motion=false,sound=false,uiScale=2}}) return true"
      },
      "label": "send valid settings with out-of-range scale"
    },
    {
      "type": "wait",
      "ms": 450,
      "label": "settle normalized settings save"
    },
    {
      "type": "call",
      "tool": "execute_luau",
      "args": {
        "datamodel_type": "Server",
        "code": "local H=game:GetService('HttpService') local p=game.Players:GetPlayers()[1] local s=H:JSONDecode(p.RPGStats.SettingsJSON.Value) return H:JSONEncode(s)"
      },
      "expectRegex": [
        "\"motion\"\\s*:\\s*false",
        "\"sound\"\\s*:\\s*false",
        "\"uiScale\"\\s*:\\s*1\\.2"
      ],
      "label": "settings clamp high scale and preserve valid booleans"
    },
    {
      "type": "call",
      "tool": "execute_luau",
      "args": {
        "datamodel_type": "Server",
        "code": "game.ServerStorage.PunchWallAutomation:Invoke('ClearCooldowns') return true"
      },
      "label": "clear action throttle before malformed settings probe"
    },
    {
      "type": "call",
      "tool": "execute_luau",
      "args": {
        "datamodel_type": "Client",
        "code": "local r=game.ReplicatedStorage.PunchWallEvents.ActionRequest r:FireServer({action='UpdateSettings',value={motion='bad',sound=0,uiScale=-9}}) return true"
      },
      "label": "send malformed settings payload"
    },
    {
      "type": "wait",
      "ms": 450,
      "label": "settle fail-safe settings normalization"
    },
    {
      "type": "call",
      "tool": "execute_luau",
      "args": {
        "datamodel_type": "Server",
        "code": "local H=game:GetService('HttpService') local p=game.Players:GetPlayers()[1] local s=H:JSONDecode(p.RPGStats.SettingsJSON.Value) return H:JSONEncode(s)"
      },
      "expectRegex": [
        "\"motion\"\\s*:\\s*true",
        "\"sound\"\\s*:\\s*true",
        "\"uiScale\"\\s*:\\s*0\\.8"
      ],
      "label": "malformed setting types fail closed to safe values"
    },
    {
      "type": "call",
      "tool": "get_console_output",
      "saveAs": "console",
      "label": "capture contextual-action console"
    },
    {
      "type": "assertNoConsoleErrors",
      "source": "console",
      "label": "contextual-action console clean"
    },
    {
      "type": "call",
      "tool": "start_stop_play",
      "args": { "is_start": false },
      "timeoutMs": 60000,
      "label": "return contextual action session to Edit"
    }
  ],
  "cleanup": [
    {
      "type": "call",
      "tool": "start_stop_play",
      "args": { "is_start": false },
      "timeoutMs": 60000,
      "allowError": true,
      "label": "cleanup contextual action session"
    }
  ]
}
